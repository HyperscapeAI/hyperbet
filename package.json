{
  "name": "@hyperbet/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hyperbet private monorepo for betting, prediction, and futures products",
  "workspaces": [
    "packages/*",
    "packages/*/app",
    "packages/*/keeper"
  ],
  "scripts": {
    "build": "bun run build:solana && bun run ci:scope:solana",
    "build:solana": "bun run --cwd packages/hyperbet-solana build",
    "dev:doctor": "bun scripts/dev-doctor.ts",
    "dev:bootstrap": "bun scripts/dev-bootstrap.ts",
    "dev:local:solana": "bun scripts/run-local-demo.ts solana",
    "test": "bun run test:launch:solana",
    "test:launch:solana": "turbo run test --filter=hyperbet-solana-app --filter=hyperbet-solana-keeper --filter=@hyperbet/sdk --filter=@hyperbet/ui && bun run --cwd packages/hyperbet-solana/anchor test",
    "test:contract:hyperia": "bun run --cwd packages/hyperbet-solana/keeper test:contract:hyperia",
    "test:solana": "bun run --cwd packages/hyperbet-solana test:e2e:local",
    "lint": "bun run lint:solana",
    "lint:solana": "turbo run lint --filter=hyperbet-solana-app... --filter=hyperbet-solana-keeper --filter=@hyperbet/sdk",
    "typecheck": "bun run typecheck:solana",
    "typecheck:solana": "turbo run typecheck --filter=hyperbet-solana-app... --filter=hyperbet-solana-keeper --filter=@hyperbet/sdk",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev:solana": "bun run --cwd packages/hyperbet-solana dev",
    "dev:solana:stream-ui": "bun run --cwd packages/hyperbet-solana dev:stream-ui",
    "deploy:pages": "bun run deploy:pages:solana",
    "deploy:pages:solana": "bun run --cwd packages/hyperbet-solana build:mainnet",
    "deploy:keeper": "bun run deploy:keeper:solana",
    "deploy:keeper:solana": "bun run --cwd packages/hyperbet-solana keeper:service",
    "keeper:duel:solana": "bun run --cwd packages/hyperbet-solana keeper:duel",
    "ci:env": "node --import tsx scripts/ci-env-audit-solana-v1.ts",
    "ci:policy:artifacts": "node --import tsx scripts/ci-artifact-policy.ts",
    "branding:check:legacy": "node scripts/check-legacy-branding.mjs",
    "ci:scope:solana": "node --import tsx scripts/ci-solana-v1-scope.ts && bun run branding:check:legacy",
    "ci:gate:solana": "node --import tsx scripts/ci-gate-scenarios.ts --target=solana",
    "ci:gate:solana:build": "node --import tsx scripts/ci-gate-solana-build.ts",
    "ci:gate:e2e:solana": "node --import tsx scripts/ci-gate-e2e.ts --chain=solana",
    "ci:gate:registry:launch": "node --import tsx scripts/ci-gate-solana-v1-registry.ts && bun test packages/hyperbet-solana/tests/deployments.test.ts packages/hyperbet-solana/tests/duel-market-artifacts.test.ts packages/hyperbet-solana/tests/build-workspace-policy.test.ts",
    "pm:stream:probe": "node --import tsx scripts/probe-hyperia-stream-headless.ts",
    "ci:prepr": "node scripts/check-pr-ready.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "bun-types": "^1.2.20",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "turbo": "^2.5.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.3",
    "viem": "2.47.0"
  },
  "packageManager": "bun@1.3.6"
}
